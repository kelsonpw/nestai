{
  "name": "@nestai/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@nestai/contracts": "workspace:*",
    "date-fns": "^3.6.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
