# NestAI environment configuration
#
# NOTE: In mock mode (PROVIDER_MODE=mock, the default) NO secrets are required.
# All external integrations resolve to in-memory mock implementations.
# Only fill in the provider credentials below when switching to live mode.

# Provider selection: "mock" (default, no secrets needed) or "live"
PROVIDER_MODE=mock

# Core infrastructure
DATABASE_URL=postgresql://nestai:nestai@localhost:5432/nestai
REDIS_URL=redis://localhost:6379
PORT=3000

# LLM provider (only required in live mode)
ANTHROPIC_API_KEY=

# --- Optional live-mode integrations (leave empty/commented in mock mode) ---

# Google (Calendar, Gmail, etc.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Twilio (SMS / voice)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# WhatsApp
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# SMTP (email)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
