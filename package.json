{
  "name": "nestai",
  "version": "0.0.0",
  "private": true,
  "description": "NestAI - household orchestrator monorepo",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @nestai/db run migrate",
    "db:seed": "pnpm --filter @nestai/db run seed",
    "demo": "tsx scripts/demo.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts && pnpm demo",
    "ci": "pnpm install --frozen-lockfile=false && turbo run build test"
  },
  "devDependencies": {
    "@nestai/adapters": "workspace:^",
    "@nestai/api": "workspace:^",
    "@nestai/contracts": "workspace:^",
    "@nestai/core": "workspace:^",
    "@nestai/db": "workspace:^",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/testing": "^10.4.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
